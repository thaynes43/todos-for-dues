# Required for dev and prod
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todos
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-chars

# Optional in dev — required in prod
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=

# Workspace OIDC (ADR-007) — optional in dev
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_HOSTED_DOMAIN=

# Boot-time admin promotion (PLAN-004) — optional
BOOTSTRAP_ADMIN_EMAIL=
