# Required for dev and prod
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todos
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-chars

# Optional in dev — required in prod
BETTER_AUTH_URL=http://localhost:3000

# Portal SSO (ADR-013) — the sigoalumni.org portal is the only identity
# source. All three must be set or sign-in is disabled (app still boots).
# TODO(cutover): the discovery URL moves to the https://sigoalumni.org origin
# at launch — today it's the portal's Cloud Run origin.
OIDC_CLIENT_ID=todos-for-dues
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://frontpage-dgmpniyoga-ue.a.run.app/.well-known/openid-configuration

# Email (ADR-005) — RESEND_API_KEY optional in dev (RESEND_TEST_MODE=true for
# tests); webhook secret + from-address required wherever email is real.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_WEBHOOK_SECRET=

# Migration-time chapter-settings seeds (migration 0004 GUCs) — required on
# first migrate of a fresh database.
BOOTSTRAP_ADMIN_RECIPIENT_EMAIL=
BOOTSTRAP_TREASURER_RECIPIENT_EMAIL=
BOOTSTRAP_MODERATORS_RECIPIENT_EMAIL=
BOOTSTRAP_CHAPTER_DISPLAY_NAME=
BOOTSTRAP_CHAPTER_TIMEZONE=America/New_York
